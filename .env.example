# URL of the doctor-backend API. Leave empty when the frontend and backend share
# the same domain, or in development (Vite forwards /api to http://localhost:4000).
VITE_API_URL=

# Clinic name shown on the patient page and the printed QR poster.
VITE_CLINIC_NAME=Clinic

# Public address of this site, used as the default QR code link.
# Leave empty to use the address the admin dashboard is opened from.
VITE_PUBLIC_URL=
