# Serves the clinic website and forwards /api to the backend.
# DOMAIN (e.g. clinic.example.com) gets an HTTPS certificate automatically.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		# PDF links carry a short-lived access token; never pass page addresses to other sites.
		Referrer-Policy no-referrer
		-Server
	}

	handle /api/* {
		# Up to 10 PDFs of 20 MB in one upload.
		request_body {
			max_size {$MAX_BODY_SIZE:210MB}
		}
		reverse_proxy {$API_UPSTREAM:backend:4000}
	}

	handle {
		root * {$SITE_ROOT:/srv}
		# Built files have content hashes in their names, so they can be cached for a year.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"
		# Pages like /patient and /admin are handled by the app itself.
		try_files {path} /index.html
		file_server
	}
}
