# Settings for `npm run build:demo` (a demo page with sample data, no backend needed).
VITE_DEMO=true
VITE_CLINIC_NAME=Demo Clinic
# Link the demo QR code opens. Set it to the published demo page address followed by #patient,
# e.g. VITE_QR_LINK=https://example.com/clinic-demo#patient npm run build:demo
VITE_QR_LINK=
